# Folder ID or https://drive.google.com/drive/folders/ID
DRIVE_FOLDER_ID=
# Service account JSON, or leave blank and run brain-loader auth.
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_OAUTH_CLIENT_FILE=.secrets/google-client.json
GOOGLE_TOKEN_FILE=.secrets/google-token.json
# Legacy annotation tools only; active source-only sync does not use OpenAI.
OPENAI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=my-documents
VISION_MODEL=gpt-4.1-mini
PINECONE_TEXT_FIELD=chunk_text
CHUNK_CHARS=2800
# English OCR for the current collection.
OCR_LANG=iso:en
# tiny is faster on CPU; small favors OCR accuracy.
OCR_MODEL_SIZE=small
# Legacy manual-review tools only; ignored by active source-only sync.
MANUAL_ANNOTATIONS_FILE=
DATA_DIR=data
# Legacy setting; strict uploaded records do not include artifact URLs.
ARTIFACT_BASE_URL=
